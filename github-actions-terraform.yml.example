name: Terraform deployment

on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - 'infrastructure/**'

permissions:
  contents: read
  id-token: write

concurrency:
  group: cloud-health-production
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: production
    defaults:
      run:
        working-directory: infrastructure

    steps:
      - uses: actions/checkout@v5

      - name: Authenticate to Google Cloud without a key
        uses: google-github-actions/auth@v3
        with:
          project_id: ${{ vars.GCP_PROJECT_ID }}
          workload_identity_provider: ${{ vars.GCP_WORKLOAD_IDENTITY_PROVIDER }}
          service_account: ${{ vars.GCP_DEPLOYMENT_SERVICE_ACCOUNT }}

      - uses: hashicorp/setup-terraform@v4
        with:
          terraform_version: 1.15.6

      - name: Initialize remote state
        run: >-
          terraform init
          -backend-config="bucket=${{ vars.TF_STATE_BUCKET }}"
          -backend-config="prefix=cloud-health/prod"

      - name: Validate
        run: terraform validate

      - name: Plan
        env:
          TF_VAR_project_id: ${{ vars.GCP_PROJECT_ID }}
          TF_VAR_config_git_uri: ${{ vars.CONFIG_GIT_URI }}
          TF_VAR_diagnostics_mongodb_uri: ${{ secrets.DIAGNOSTICS_MONGODB_URI }}
          TF_VAR_github_repository: ${{ github.repository }}
        run: terraform plan -out=tfplan -input=false

      - name: Apply
        env:
          TF_VAR_project_id: ${{ vars.GCP_PROJECT_ID }}
          TF_VAR_config_git_uri: ${{ vars.CONFIG_GIT_URI }}
          TF_VAR_diagnostics_mongodb_uri: ${{ secrets.DIAGNOSTICS_MONGODB_URI }}
          TF_VAR_github_repository: ${{ github.repository }}
        run: terraform apply -input=false tfplan
