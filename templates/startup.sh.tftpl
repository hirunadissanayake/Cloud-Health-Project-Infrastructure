#!/usr/bin/env bash
set -Eeuo pipefail

exec > >(tee -a /var/log/cloud-health-startup.log | logger -t cloud-health-startup) 2>&1

echo "Starting Cloud Health release ${release_version}"
export DEBIAN_FRONTEND=noninteractive

for attempt in 1 2 3; do
  apt-get update && apt-get install -y ca-certificates curl jq nodejs npm ${java_package} && break
  if [ "$attempt" = 3 ]; then
    echo "Package installation failed after three attempts" >&2
    exit 1
  fi
  sleep 15
done

command -v java >/dev/null
java -version
npm install --global pm2@latest

if ! id cloudhealth >/dev/null 2>&1; then
  useradd --create-home --shell /bin/bash cloudhealth
fi

install -d -o cloudhealth -g cloudhealth \
  /opt/cloud-health/apps /opt/cloud-health/webapp /var/log/cloud-health /home/cloudhealth/.pm2
install -d -m 0750 -o root -g cloudhealth /etc/cloud-health

metadata_token() {
  curl --fail --silent \
    -H 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' \
    | jq -r '.access_token'
}

TOKEN="$(metadata_token)"

read_secret() {
  local secret="$1"
  curl --fail --silent \
    -H "Authorization: Bearer $TOKEN" \
    "https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets/$secret/versions/latest:access" \
    | jq -r '.payload.data' | tr '_-' '/+' | base64 --decode
}

download_artifact() {
  local application="$1"
  local destination="/opt/cloud-health/apps/$application.jar"
  local object="releases%2F${release_version}%2F$application.jar"
  echo "Downloading $application"
  curl --fail --silent --show-error --retry 5 --retry-all-errors \
    -H "Authorization: Bearer $TOKEN" \
    "https://storage.googleapis.com/storage/v1/b/${artifact_bucket}/o/$object?alt=media" \
    --output "$destination"
  chown cloudhealth:cloudhealth "$destination"
  chmod 0440 "$destination"
}

for application in config-server discovery-server api-gateway patient-service diagnostics-service file-service; do
  download_artifact "$application"
done

echo "Downloading webapp"
curl --fail --silent --show-error --retry 5 --retry-all-errors \
  -H "Authorization: Bearer $TOKEN" \
  "https://storage.googleapis.com/storage/v1/b/${artifact_bucket}/o/releases%2F${release_version}%2Fwebapp.tar.gz?alt=media" \
  --output /tmp/cloud-health-webapp.tar.gz
tar -xzf /tmp/cloud-health-webapp.tar.gz -C /opt/cloud-health/webapp
chown -R cloudhealth:cloudhealth /opt/cloud-health/webapp
rm -f /tmp/cloud-health-webapp.tar.gz

cat > /opt/cloud-health/webapp-runner.mjs <<'WEBAPP_RUNNER'
import { startServer } from './webapp/server.mjs';

startServer();
WEBAPP_RUNNER
chown cloudhealth:cloudhealth /opt/cloud-health/webapp-runner.mjs
chmod 0440 /opt/cloud-health/webapp-runner.mjs

PATIENT_DB_PASSWORD="$(read_secret '${patient_password_secret}')"
DIAGNOSTICS_MONGODB_URI="$(read_secret '${mongodb_uri_secret}')"

cat > /etc/cloud-health/runtime.env <<'ENV_HEADER'
SPRING_PROFILES_ACTIVE=git
CONFIG_SERVER_URL=http://127.0.0.1:8888
EUREKA_DEFAULT_ZONE=http://127.0.0.1:8761/eureka/
HEALTHCARE_LOG_DIR=/var/log/cloud-health
JAVA_TOOL_OPTIONS="-XX:InitialRAMPercentage=2.0 -XX:MaxRAMPercentage=12.0 -XX:+ExitOnOutOfMemoryError"
ENV_HEADER

cat >> /etc/cloud-health/runtime.env <<ENV_VALUES
CONFIG_GIT_URI=${config_git_uri}
CONFIG_GIT_BRANCH=${config_git_branch}
PATIENT_DB_URL=jdbc:postgresql://${database_private_ip}:5432/${database_name}?sslmode=require
PATIENT_DB_USERNAME=${database_user}
PATIENT_DB_PASSWORD=$PATIENT_DB_PASSWORD
DIAGNOSTICS_MONGODB_URI=$DIAGNOSTICS_MONGODB_URI
GCP_PROJECT_ID=${project_id}
MEDICAL_FILES_BUCKET=${medical_bucket}
FIRESTORE_DATABASE=(default)
FILE_METADATA_COLLECTION=medical_files
SIGNED_URL_SERVICE_ACCOUNT=${runtime_service_account}
ENV_VALUES

unset PATIENT_DB_PASSWORD DIAGNOSTICS_MONGODB_URI
chown root:cloudhealth /etc/cloud-health/runtime.env
chmod 0640 /etc/cloud-health/runtime.env

cat > /usr/local/bin/cloud-health-run <<'RUNNER'
#!/usr/bin/env bash
set -Eeuo pipefail
set -a
source /etc/cloud-health/runtime.env
set +a
exec java -jar "/opt/cloud-health/apps/$1.jar"
RUNNER
chmod 0755 /usr/local/bin/cloud-health-run

cat > /opt/cloud-health/health-server.mjs <<'HEALTH_SERVER'
import { createServer } from 'node:http';

const checks = [
  ...[8888, 8761, 8080, 8081, 8082, 8083].map(port =>
    'http://127.0.0.1:' + port + '/actuator/health/readiness'),
  'http://127.0.0.1:3000/healthz',
  'http://127.0.0.1:8870/healthz'
];

createServer(async (_request, response) => {
  const results = await Promise.allSettled(checks.map(url =>
    fetch(url, { signal: AbortSignal.timeout(2500) }).then(result => {
      if (!result.ok) throw new Error(url + ' returned ' + result.status);
      return result.json();
    })));
  const healthy = results.every(result => result.status === 'fulfilled'
    && result.value.status === 'UP');
  response.statusCode = healthy ? 200 : 503;
  response.setHeader('content-type', 'application/json');
  response.end(JSON.stringify({
    status: healthy ? 'UP' : 'DOWN',
    services: results.map((result, index) => ({
      url: checks[index],
      status: result.status === 'fulfilled' ? result.value.status : 'DOWN'
    }))
  }));
}).listen(8090, '0.0.0.0');
HEALTH_SERVER
chown cloudhealth:cloudhealth /opt/cloud-health/health-server.mjs
chmod 0440 /opt/cloud-health/health-server.mjs

cat > /opt/cloud-health/platform-proxy.mjs <<'PLATFORM_PROXY'
import { createServer, request } from 'node:http';

createServer(async (clientRequest, clientResponse) => {
  if (clientRequest.url === '/healthz') {
    const checks = [8888, 8761].map(port =>
      fetch('http://127.0.0.1:' + port + '/actuator/health/readiness', {
        signal: AbortSignal.timeout(2500)
      }).then(response => response.ok));
    const results = await Promise.allSettled(checks);
    const healthy = results.every(result => result.status === 'fulfilled' && result.value);
    clientResponse.writeHead(healthy ? 200 : 503, { 'content-type': 'application/json' });
    clientResponse.end(JSON.stringify({ status: healthy ? 'UP' : 'DOWN' }));
    return;
  }

  const publicHost = clientRequest.headers.host || '';
  const targetPort = publicHost.endsWith(':8761') ? 8761 : 8888;
  const headers = { ...clientRequest.headers, host: '127.0.0.1:' + targetPort };
  const upstream = request({
    hostname: '127.0.0.1',
    port: targetPort,
    path: clientRequest.url,
    method: clientRequest.method,
    headers
  }, upstreamResponse => {
    clientResponse.writeHead(upstreamResponse.statusCode || 502, upstreamResponse.headers);
    upstreamResponse.pipe(clientResponse);
  });
  upstream.on('error', error => {
    if (!clientResponse.headersSent) {
      clientResponse.writeHead(502, { 'content-type': 'text/plain; charset=utf-8' });
    }
    clientResponse.end('Platform service unavailable: ' + error.message);
  });
  clientRequest.pipe(upstream);
}).listen(8870, '0.0.0.0');
PLATFORM_PROXY
chown cloudhealth:cloudhealth /opt/cloud-health/platform-proxy.mjs
chmod 0440 /opt/cloud-health/platform-proxy.mjs

cat > /opt/cloud-health/ecosystem.config.cjs <<'PM2_CONFIG'
const applications = [
  ['config-server', 8888],
  ['discovery-server', 8761],
  ['api-gateway', 8080],
  ['patient-service', 8081],
  ['diagnostics-service', 8082],
  ['file-service', 8083]
];

module.exports = {
  apps: [
    ...applications.map(([name, port]) => ({
      name,
      script: '/usr/local/bin/cloud-health-run',
      args: name,
      interpreter: '/bin/bash',
      autorestart: true,
      max_restarts: 20,
      restart_delay: 5000,
      kill_timeout: 25000,
      output: '/var/log/cloud-health/' + name + '-out.log',
      error: '/var/log/cloud-health/' + name + '-error.log',
      env: { SERVER_PORT: String(port) }
    })),
    {
      name: 'webapp',
      script: '/opt/cloud-health/webapp-runner.mjs',
      interpreter: 'node',
      autorestart: true,
      max_restarts: 20,
      restart_delay: 5000,
      output: '/var/log/cloud-health/webapp-out.log',
      error: '/var/log/cloud-health/webapp-error.log',
      env: {
        PORT: '3000',
        API_GATEWAY_URL: 'http://127.0.0.1:8080'
      }
    },
    {
      name: 'platform-proxy',
      script: '/opt/cloud-health/platform-proxy.mjs',
      interpreter: 'node',
      autorestart: true,
      output: '/var/log/cloud-health/platform-proxy-out.log',
      error: '/var/log/cloud-health/platform-proxy-error.log'
    },
    {
      name: 'health-monitor',
      script: '/opt/cloud-health/health-server.mjs',
      interpreter: 'node',
      autorestart: true,
      output: '/var/log/cloud-health/health-monitor-out.log',
      error: '/var/log/cloud-health/health-monitor-error.log'
    }
  ]
};
PM2_CONFIG
chown cloudhealth:cloudhealth /opt/cloud-health/ecosystem.config.cjs

sudo -u cloudhealth env PM2_HOME=/home/cloudhealth/.pm2 pm2 start /opt/cloud-health/ecosystem.config.cjs

wait_for_readiness() {
  local application="$1"
  local port="$2"
  for attempt in $(seq 1 60); do
    if curl --fail --silent "http://127.0.0.1:$port/actuator/health/readiness" >/dev/null; then
      echo "$application is ready"
      return 0
    fi
    sleep 5
  done
  echo "$application did not become ready within 5 minutes" >&2
  return 1
}

# Dependent services may launch before Config Server on a fresh VM. Restart them
# in dependency order so they always import the Git-backed configuration.
wait_for_readiness "Config Server" 8888
sudo -u cloudhealth env PM2_HOME=/home/cloudhealth/.pm2 pm2 restart discovery-server
wait_for_readiness "Discovery Server" 8761
sudo -u cloudhealth env PM2_HOME=/home/cloudhealth/.pm2 \
  pm2 restart api-gateway patient-service diagnostics-service file-service

sudo -u cloudhealth env PM2_HOME=/home/cloudhealth/.pm2 pm2 save
env PATH="$PATH:/usr/bin" PM2_HOME=/home/cloudhealth/.pm2 pm2 startup systemd -u cloudhealth --hp /home/cloudhealth
systemctl enable pm2-cloudhealth

if curl --fail --silent --show-error --retry 3 \
  https://dl.google.com/cloudagents/add-google-cloud-ops-agent-repo.sh \
  --output /tmp/add-google-cloud-ops-agent-repo.sh; then
  bash /tmp/add-google-cloud-ops-agent-repo.sh --also-install || true
fi

if [ -d /etc/google-cloud-ops-agent ]; then
  cat > /etc/google-cloud-ops-agent/config.yaml <<'OPS_AGENT'
logging:
  receivers:
    cloud_health_files:
      type: files
      include_paths:
        - /var/log/cloud-health/*.log
  service:
    pipelines:
      cloud_health_pipeline:
        receivers: [cloud_health_files]
metrics:
  service:
    pipelines:
      default_pipeline:
        receivers: [hostmetrics]
OPS_AGENT
  systemctl restart google-cloud-ops-agent || true
fi

for attempt in $(seq 1 60); do
  if curl --fail --silent http://127.0.0.1:8090/healthz >/dev/null; then
    echo "All Cloud Health processes are ready"
    exit 0
  fi
  sleep 10
done

echo "Applications did not become healthy within 10 minutes" >&2
sudo -u cloudhealth env PM2_HOME=/home/cloudhealth/.pm2 pm2 status || true
exit 1
